# ===== Local-only scratch space ======================================
# tmp/ holds every transient local artifact: ad-hoc test media
# (tmp/test-assets), GUI verification screenshots
# (tmp/gui-test-screenshots), archived one-off junk (tmp/archive).
# Nothing under tmp/ is ever committed.
tmp/

# Private development notes
dev_notes/

# Code assistant scratch plans
.zcode/

# One-off diagnostic scripts and screenshots dropped at the repo root
tmp_*.ps1
step*.png

# ===== Frontend transients ===========================================
frontend/logs/
frontend/scripts/
frontend/test-results/

# ===== Backend local assets ==========================================
# Downloaded TTS/ASR model weights + HuggingFace cache live here.
backend/ml_models/
