# Django Backend Environment Template
# Copy this file to .env and fill in your actual values
# Do NOT commit your actual .env file to version control

# Django settings
SECRET_KEY=replace-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Model APIs are configured per user inside Project Settings.
# Only shared backend integrations belong in this file.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=

# Realtime voice input (ASR). Requires backend/requirements-asr.txt;
# without the package the endpoints return a readiness hint instead of failing.
# base = latency-first default (~1.4s median for short clips on CPU);
# switch to small for better accuracy at ~3x latency.
ASR_PROVIDER=faster_whisper
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# Default chat session values
DEFAULT_CHAT_WORLD_TIME=Current time
DEFAULT_CHAT_USER_PERSONA=
DEFAULT_CHAT_ENABLE_WEB_SEARCH=False
DEFAULT_CHAT_OUTPUT_LANGUAGE=Simplified Chinese
DEFAULT_CHAT_ADDITIONAL_CONTEXT=

# Development auto-login
DEV_AUTO_LOGIN_ENABLED=True
DEV_AUTO_LOGIN_USERNAME=demo_user
DEV_AUTO_LOGIN_EMAIL=demo@example.com

# Database
DATABASE_NAME=prismate
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Execute Celery tasks in-process (dev convenience: chat works without a worker)
CELERY_TASK_ALWAYS_EAGER=True
# Run memory writes in-process when the broker rejects enqueue (prod: keep False)
MEMORY_SYNC_INLINE_FALLBACK=False
